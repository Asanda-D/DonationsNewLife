<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".DropOffZonesFragment">

    <!-- Map Section -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="16dp" />

    <!-- Address Info -->
    <TextView
        android:id="@+id/txtAddressInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Address:\n03 West Riding Road, Hillcrest, KZN\n\nDrop-Off Hours:\nMonday to Friday, 8:00 AM – 4:00 PM\n\nWe kindly ask that all donations be made during working hours."
        android:textSize="14sp"
        android:padding="8dp" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wishlistTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Wishlist"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnEditWishlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            android:visibility="gone"/> <!-- default hidden, shown if admin -->

    </LinearLayout>

    <!-- RecyclerView as table -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerWishlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:nestedScrollingEnabled="false"/>

</LinearLayout>